    "Pro で 10 階より深く。番人 4 人と、こだま・幽霊・彗星の石。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go past Floor 10 with Pro: four more wardens and the Echo, Ghost and Comet stones."
          }
        }
      }
    },
    "Pro でできること": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Pro adds"
